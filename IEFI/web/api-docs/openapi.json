{
  "openapi": "3.0.3",
  "info": {
    "title": "Kinesio.Saludd | API de la IEFI",
    "version": "1.0.0",
    "description": "TP3 de Aplicaciones Web 2. Cinco endpoints para consultar y administrar servicios."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/servicios": {
      "get": {
        "summary": "Listar todos los servicios",
        "tags": [
          "Servicios"
        ],
        "responses": {
          "200": {
            "description": "Listado de servicios",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Servicio"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error de base de datos"
          }
        }
      },
      "post": {
        "summary": "Agregar un servicio",
        "tags": [
          "Servicios"
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/Datos"
        },
        "responses": {
          "201": {
            "description": "Servicio creado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Servicio"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos"
          },
          "401": {
            "description": "Se requiere una sesión vigente.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mensaje": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Origen de solicitud rechazado.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mensaje": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error de base de datos"
          }
        },
        "security": [
          {
            "sesion": []
          }
        ]
      }
    },
    "/api/servicios/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "get": {
        "summary": "Consultar un servicio por ID",
        "tags": [
          "Servicios"
        ],
        "responses": {
          "200": {
            "description": "Servicio encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Servicio"
                }
              }
            }
          },
          "404": {
            "description": "No encontrado"
          }
        }
      },
      "put": {
        "summary": "Modificar un servicio",
        "tags": [
          "Servicios"
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/Datos"
        },
        "responses": {
          "200": {
            "description": "Servicio modificado"
          },
          "400": {
            "description": "Datos inválidos"
          },
          "401": {
            "description": "Se requiere una sesión vigente.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mensaje": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Origen de solicitud rechazado.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mensaje": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No encontrado"
          }
        },
        "security": [
          {
            "sesion": []
          }
        ]
      },
      "delete": {
        "summary": "Eliminar un servicio",
        "tags": [
          "Servicios"
        ],
        "responses": {
          "200": {
            "description": "Servicio eliminado"
          },
          "401": {
            "description": "Se requiere una sesión vigente.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mensaje": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Origen de solicitud rechazado.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mensaje": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No encontrado"
          }
        },
        "security": [
          {
            "sesion": []
          }
        ]
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Sesión"
        ],
        "summary": "Iniciar sesión",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "clave"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "clave": {
                    "type": "string",
                    "format": "password"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sesión iniciada.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "email": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "description": "Cookie HttpOnly con JWT",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Datos incompletos.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mensaje": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Credenciales incorrectas.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mensaje": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Límite de intentos.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mensaje": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/sesion": {
      "get": {
        "tags": [
          "Sesión"
        ],
        "summary": "Consultar la sesión actual",
        "security": [
          {
            "sesion": []
          }
        ],
        "responses": {
          "200": {
            "description": "Sesión activa.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "email": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Se requiere una sesión vigente.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mensaje": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Sesión"
        ],
        "summary": "Cerrar sesión",
        "security": [
          {
            "sesion": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "example": {}
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sesión cerrada.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mensaje": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/turnos": {
      "get": {
        "tags": [
          "Turnos"
        ],
        "summary": "Consultar solicitudes de turno",
        "security": [
          {
            "sesion": []
          }
        ],
        "responses": {
          "200": {
            "description": "Solicitudes registradas.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "nombre",
                      "telefono",
                      "fecha",
                      "hora",
                      "profesional"
                    ],
                    "properties": {
                      "id": {
                        "type": "integer"
                      },
                      "nombre": {
                        "type": "string",
                        "maxLength": 100
                      },
                      "telefono": {
                        "type": "string",
                        "maxLength": 30
                      },
                      "fecha": {
                        "type": "string",
                        "format": "date"
                      },
                      "hora": {
                        "type": "string",
                        "example": "15:30"
                      },
                      "profesional": {
                        "type": "string",
                        "enum": [
                          "Rocio",
                          "Agustina"
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Se requiere una sesión vigente.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mensaje": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "La API externa no respondió.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mensaje": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Turnos"
        ],
        "summary": "Registrar una solicitud de turno",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "nombre",
                  "telefono",
                  "fecha",
                  "hora",
                  "profesional"
                ],
                "properties": {
                  "nombre": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "telefono": {
                    "type": "string",
                    "maxLength": 30
                  },
                  "fecha": {
                    "type": "string",
                    "format": "date"
                  },
                  "hora": {
                    "type": "string",
                    "example": "15:30"
                  },
                  "profesional": {
                    "type": "string",
                    "enum": [
                      "Rocio",
                      "Agustina"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Solicitud registrada.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "nombre",
                    "telefono",
                    "fecha",
                    "hora",
                    "profesional"
                  ],
                  "properties": {
                    "id": {
                      "type": "integer"
                    },
                    "nombre": {
                      "type": "string",
                      "maxLength": 100
                    },
                    "telefono": {
                      "type": "string",
                      "maxLength": 30
                    },
                    "fecha": {
                      "type": "string",
                      "format": "date"
                    },
                    "hora": {
                      "type": "string",
                      "example": "15:30"
                    },
                    "profesional": {
                      "type": "string",
                      "enum": [
                        "Rocio",
                        "Agustina"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mensaje": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "502": {
            "description": "La API externa no respondió.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mensaje": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Servicio": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "nombre": {
            "type": "string",
            "example": "Masoterapia"
          },
          "descripcion": {
            "type": "string",
            "example": "Masajes terapéuticos."
          },
          "activo": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "Datos": {
        "type": "object",
        "required": [
          "nombre",
          "descripcion",
          "activo"
        ],
        "properties": {
          "nombre": {
            "type": "string",
            "maxLength": 70
          },
          "descripcion": {
            "type": "string",
            "maxLength": 250
          },
          "activo": {
            "type": "boolean"
          }
        }
      }
    },
    "requestBodies": {
      "Datos": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Datos"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "sesion": {
        "type": "apiKey",
        "in": "cookie",
        "name": "kinesio_sesion"
      }
    }
  }
}
